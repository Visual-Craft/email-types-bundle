{
    "type": "symfony-bundle",
    "name": "visual-craft/email-types-bundle",
    "description": "Symfony Bundle for structured email composing",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/mailer": "^6.0|^7.0|^8.0",
        "symfony/options-resolver": "^6.0|^7.0|^8.0",
        "symfony/twig-bridge": "^6.0|^7.0|^8.0",
        "symfony/translation": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "VisualCraft\\EmailTypesBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VisualCraft\\EmailTypesBundle\\Tests\\TestApplication\\": "tests/TestApplication/src/",
            "VisualCraft\\EmailTypesBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^6.0|^7.0|^8.0",
        "symfony/twig-bundle": "^6.0|^7.0|^8.0",
        "visual-craft/php-cs-fixer-config": "^0.5",
        "friendsofphp/php-cs-fixer": "v3.91.3"
    },
    "scripts": {
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff -v --ansi",
        "cs-fix": "vendor/bin/php-cs-fixer fix --diff -v --ansi",
        "lint": [
            "@cs-fix",
            "@composer validate --no-check-all"
        ]
    }
}
